<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#009dff"
    android:padding="16dp">


    <!--หน้าจอแสดง-->
    <TextView
        android:id="@+id/txtdisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:padding="16dp"
        android:textColor="#6cc232"
        android:gravity="center"
        android:background="#203c5c"
        android:layout_marginBottom="12dp"
        android:textSize="36sp"/>
    <!--โซนปุ่ม-->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="8dp">

        <!--แถวที่1-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <!--        แถวปุ่ม-->
            <Button
                android:id="@+id/btnac"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="AC"
                android:textColor="#ffffff"
                android:backgroundTint="#5e5f6e "

                android:textStyle="bold"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btndel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="DEL"
                android:backgroundTint="#5e5f6e"
                android:textColor="#ffffff"
                android:textStyle="bold"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btnmod"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="%"
                android:backgroundTint="#5e5f6e"
                android:textColor="#ffffff"
                android:textStyle="bold"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btndivide"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="/"
                android:backgroundTint="#4550ed"
                android:textColor="#ffffff"
                android:textStyle="bold"
                android:layout_margin="4dp"/>



        </LinearLayout>

        <!--แถวที่2-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <!--        แถวปุ่ม-->
            <Button
                android:id="@+id/btn7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="#6b7475"
                android:textColor="#ffffff"
                android:text="7"
                android:textStyle="bold"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btn8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="#6b7475"
                android:textColor="#ffffff"
                android:text="8"
                android:textStyle="bold"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btn9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="#6b7475"
                android:textColor="#ffffff"
                android:text="9"
                android:textStyle="bold"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btnmuti"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="#4550ed"
                android:textColor="#ffffff"
                android:text="*"
                android:textStyle="bold"
                android:layout_margin="4dp"/>
        </LinearLayout>

        <!--แถวที่3-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <!--        แถวปุ่ม-->
            <Button
                android:id="@+id/btn4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:backgroundTint="#6b7475"
                android:textColor="#ffffff"
                android:layout_weight="1"
                android:text="4"
                android:textStyle="bold"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btn5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="5"
                android:textStyle="bold"
                android:backgroundTint="#6b7475"
                android:textColor="#ffffff"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btn6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="6"
                android:textStyle="bold"
                android:backgroundTint="#6b7475"
                android:textColor="#ffffff"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btnminus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="-"
                android:backgroundTint="#4550ed"
                android:textColor="#ffffff"
                android:textStyle="bold"
                android:layout_margin="4dp"/>
        </LinearLayout>
        <!--แถวที่2-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <!--        แถวปุ่ม-->
            <Button
                android:id="@+id/btn1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="1"
                android:backgroundTint="#6b7475"
                android:textColor="#ffffff"
                android:textStyle="bold"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btn2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="2"
                android:backgroundTint="#6b7475"
                android:textColor="#ffffff"
                android:textStyle="bold"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btn3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="3"
                android:textStyle="bold"
                android:backgroundTint="#6b7475"
                android:textColor="#ffffff"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btnplus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:textColor="#ffffff"
                android:layout_weight="1"
                android:text="+"
                android:textStyle="bold"

                android:backgroundTint="#4550ed"
                android:layout_margin="4dp"/>
        </LinearLayout>
        <!--แถวที่2-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <!--        แถวปุ่ม-->
            <Button
                android:id="@+id/btnplusminus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:textColor="#ffffff"
                android:text="±"
                android:backgroundTint="#6b7475"
                android:textStyle="bold"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btn0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:textColor="#ffffff"
                android:backgroundTint="#6b7475"
                android:text="0"
                android:textStyle="bold"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btndot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:textColor="#ffffff"
                android:text="."
                android:backgroundTint="#6b7475"
                android:textStyle="bold"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/btnresult"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:textColor="#ffffff"
                android:text="="
                android:textStyle="bold"
                android:backgroundTint="#4550ed"
                android:layout_margin="4dp"/>
        </LinearLayout>

    </LinearLayout>


</LinearLayout>
